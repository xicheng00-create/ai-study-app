  "concept": "AIGC 是什么？其英文全称是什么？",
  "source": "books/AI产品地图/第1章-大模型是什么-概念扫盲",
  "form": "myth",
  "skeleton": "因为有人把 AIGC 理解成「让 AI 变聪明」，所以一直以为关键在模型；其实 AIGC 的关键动作是「自动生成内容」——模型只负责生成，产物才是成品，所以它是把 AI 变成生产工具。",
  "pages": [
    {"n": 1, "job": "演出他以为的答案", "claim": "大多数人的第一反应是「AI 更聪明了」", "visual": "dialogue", "why": "开场先站在观众的误解里，后面才有得剥"},
    {"n": 2, "job": "把误解钉死并打叉", "claim": "「AI 变聪明」不是 AIGC 的定义", "visual": "crossout", "why": "误解必须被明确否掉，否则机制讲了也没落点"},
    {"n": 3, "job": "给出真正的机制：模型到成品的一条链", "claim": "内容是模型一环一环生成出来的", "visual": "chain", "why": "先破后立，破完立刻立因果链"},
    {"n": 4, "job": "压成一句可记的定性", "claim": "自动生成内容，才是它区别于旧 AI 的性质", "visual": "transform", "why": "链讲完要收成一句话，才好带走"},
    {"n": 5, "job": "把抽象的「内容」摊成看得见的形式", "claim": "文字、图片、视频、音乐、代码都属于内容", "visual": "stack", "why": "具体先于抽象，落到他已经见过的形态"},
    {"n": 6, "job": "换一个视角：为什么这不是新东西", "claim": "AI 早就在区分「看懂」和「创造」", "visual": "axis", "why": "把 1.0 到 2.0 的迁徙落成一维标尺，解释为什么现在才叫 AIGC"},
    {"n": 7, "job": "收束回开场，误解解开", "claim": "关键不是它更聪明，而是它开始生产", "visual": "close", "why": "回到第一场的画面，但误解已经消失"},
    {"n": 8, "job": "出处卡", "claim": "这页的来处", "visual": "source", "why": "固定最后一页"}
